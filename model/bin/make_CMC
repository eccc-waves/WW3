#!/bin/sh

TR0=1 # Build with TR0 switch
TR1=1 # Build with TR1 switch (RDWPS NEP)
SEQ=1 # Build utility programs (sequential)
MPI=1 # Build model (mpi)

# Load intel compiler and code-tools (if not already done)
#. r.load.dot eccc/mrd/rpn/code-tools/ENV/cdt-1.5.5-inteloneapi-2022.1.2
# Load rmn lib
. r.load.dot rpn/libs/20220216
# Load NetCDF
. ssmuse-sh -x main/opt/hdf5-netcdf4/serial/static/inteloneapi-2022.1.2/01

export WWATCH3_NETCDF=NC4
export NETCDF_CONFIG=$(which nc-config)
# Graph partitionning for unstructured grid
export METIS_PATH=/home/bpo001/models/WW3/local

if [ -z "$WWATCH3_NETCDF" ]; then
    ww3_NetCDF=
else
    ww3_NetCDF="ww3_ounf ww3_ounp ww3_bounc"
fi

ww3_mpi="ww3_shel ww3_multi"
ww3_seq="ww3_grid ww3_strt ww3_outp ww3_ousf ww3_prsf ww3_bounm ww3_rstrt ww3_uprstr ww3_gint $ww3_NetCDF"

if [[ $TR0 -eq 1 ]]; then
  mkdir ../exe_tr0

  if [[ $SEQ -eq 1 ]]; then
    # TR0 SEQ
    cp switch_CMC_1 switch
    ./w3_make $ww3_mpi
    cp ../exe/ww3_* ../exe_tr0/
  fi

  if [[ $MPI -eq 1 ]]; then
    # TR0 MPI with MLIM
    sed 's/SHRD/DIST MPI/g' switch_CMC_1 > switch
    ./w3_make $ww3_mpi
    for f in $ww3_mpi; do
      mv ../exe/$f ../exe_tr0/${f}_mlim
    done

    # TR0 MPI without MLIM
    sed 's/SHRD/DIST MPI/g;s/MLIM//g' switch_CMC_1 > switch
    ./w3_make $ww3_mpi
    cp ../exe/ww3_* ../exe_tr0/
  fi
fi

if [[ $TR1 -eq 1 ]]; then
  mkdir ../exe_tr1

  if [[ $SEQ -eq 1 ]]; then
    # TR1 SEQ
    cp switch_CMC_2 switch
    ./w3_make $ww3_mpi
    cp ../exe/ww3_* ../exe_tr1/
  fi

  if [[ $MPI -eq 1 ]]; then
    # TR1 MPI with PDLIB
    sed 's/SHRD/DIST MPI/g' switch_CMC_2_pdlib > switch
    ./w3_make $ww3_mpi
    cp ../exe/ww3_* ../exe_tr1/
  fi
fi

